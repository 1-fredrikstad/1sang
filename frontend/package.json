{
  "name": "1sang",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --webpack",
    "dev:cypress": "cross-env NEXT_PUBLIC_CYPRESS=true next dev --webpack",
    "dev:cypress:admin": "cross-env CYPRESS_E2E=true NEXT_PUBLIC_CYPRESS=true NEXT_PUBLIC_CYPRESS_ADMIN=true CYPRESS_ADMIN=true next dev --webpack",
    "build": "rm -rf .next && next build --webpack",
    "start": "next start",
    "seed:songs": "node --env-file=.env.local ./scripts/seed-songs.mjs",
    "lint": "eslint",
    "format:check": "prettier --check .",
    "format:write": "prettier --write .",
    "prepare": "node -e \"if (process.env.VERCEL !== '1') { require('child_process').execSync('husky', {stdio: 'inherit'}) }\"",
    "test": "vitest",
    "cypress": "cypress open",
    "test:e2e": "start-server-and-test dev:cypress http://localhost:3000 cypress"
  },
  "dependencies": {
    "@heroicons/react": "^2.2.0",
    "@serwist/next": "^9.5.11",
    "@serwist/precaching": "^9.5.11",
    "@serwist/sw": "^9.5.11",
    "@supabase/ssr": "^0.10.3",
    "@supabase/supabase-js": "^2.106.2",
    "@vercel/analytics": "^2.0.1",
    "@vercel/speed-insights": "^2.0.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cookies-next": "^6.1.1",
    "dexie": "^4.4.3",
    "dexie-react-hooks": "^4.4.0",
    "idb": "^8.0.3",
    "localstorage-slim": "^2.7.1",
    "lucide-react": "^1.17.0",
    "next": "16.2.7",
    "next-themes": "^0.4.6",
    "postcss": "^8.5.15",
    "radix-ui": "^1.4.3",
    "react": "19.2.6",
    "react-dom": "19.2.6",
    "react-hook-form": "^7.76.1",
    "react-icons": "^5.6.0",
    "react-swipeable": "^7.0.2",
    "server-only": "^0.0.1",
    "serwist": "^9.5.11",
    "shadcn": "^4.8.2",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.6.0",
    "tw-animate-css": "^1.4.0",
    "uuid": "^14.0.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.0",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^25.9.1",
    "@types/react": "^19.2.15",
    "@types/react-dom": "^19.2.3",
    "cross-env": "^10.1.0",
    "cypress": "^15.16.0",
    "eslint": "^9.39.4",
    "eslint-config-next": "16.2.6",
    "eslint-config-prettier": "^10.1.8",
    "fake-indexeddb": "^6.2.5",
    "husky": "^9.1.7",
    "jsdom": "^29.1.1",
    "lint-staged": "^17.0.5",
    "prettier": "3.8.3",
    "start-server-and-test": "^3.0.5",
    "tailwindcss": "^4.3.0",
    "typescript": "^6.0.3",
    "vitest": "^4.1.7"
  },
  "lint-staged": {
    "*.{js,ts,tsx}": [
      "eslint --cache --fix",
      "prettier --write"
    ],
    "*.{css,scss,json,md}": "prettier --write"
  }
}
